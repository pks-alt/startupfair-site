{
  "name": "StartupFair Preview",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "npm run install:ci",
  "postStartCommand": "nohup npm run dev >/tmp/startupfair-vite.log 2>&1 &",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "StartupFair Preview",
      "onAutoForward": "openBrowser"
    }
  }
}
